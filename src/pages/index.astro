---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.id < b.id ? -1 : 1)
);
---
<BaseLayout>
  <section class="hero">
    <h1 class="hero-title">{site.title}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="hero-sub">{site.description}</p>
  </section>

  <section id="about" class="about">
    <h2>About</h2>
    <p>{site.about}</p>
  </section>

  <section id="work" class="work">
    <h2>Software &amp; Games</h2>
    <div class="showcase">
      {projects.map((entry, i) => (
        <article
          class="card"
          data-type={entry.data.type}
          style={`--i: ${i}`}
        >
          <span class="card-badge">{entry.data.type}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.description}</p>
          <a href={entry.data.href} class="card-link" target="_blank" rel="noopener noreferrer">
            Learn more →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="contact">
    <h2>Contact</h2>
    <p>Say hello or follow along:</p>
    <ul class="contact-links">
      {site.contact.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
