---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
---
<BaseLayout title="Support" description="Get help with Messier 16 software and games.">
  <article class="page">
    <h1>Support</h1>
    <p class="page-lede">We’re here to help. Choose how you’d like to reach us.</p>

    <div class="prose">
      <h2>Contact us</h2>
      <p>
        For general questions, feedback, or issues with our apps and games, get in touch:
      </p>
      <ul class="contact-list">
        {site.contact.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </li>
        ))}
      </ul>

      <h2>What to include</h2>
      <p>
        When reporting a bug or problem, please include your device or platform (e.g. Windows, macOS, iOS), the app or game name, and a short description. Screenshots or steps to reproduce help us fix things faster.
      </p>

      <h2>Response time</h2>
      <p>
        We’re a small studio, so we can’t guarantee instant replies—but we do read everything and aim to respond within a few business days.
      </p>
    </div>
  </article>
</BaseLayout>
