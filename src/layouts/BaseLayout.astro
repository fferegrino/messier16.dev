---
import { site } from '@/config/site';
import '@/styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Software &amp; Game Development</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a href={import.meta.env.BASE_URL} class="logo">Messier 16</a>
      <nav>
        <a href={`${import.meta.env.BASE_URL}#about`}>About</a>
        <a href={`${import.meta.env.BASE_URL}#work`}>Work</a>
        <a href={`${import.meta.env.BASE_URL}#contact`}>Contact</a>
        <a href={`${import.meta.env.BASE_URL}/support`}>Support</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Messier 16</p>
      <nav class="footer-nav">
        <a href={`${import.meta.env.BASE_URL}/privacy`}>Privacy</a>
        <a href={`${import.meta.env.BASE_URL}/support`}>Support</a>
      </nav>
    </footer>
  </body>
</html>
